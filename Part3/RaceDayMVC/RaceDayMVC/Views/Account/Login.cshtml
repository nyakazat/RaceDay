@model RaceDayMVC.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login - RaceDay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background: #101827;
            color: white;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
        }

        .login-card {
            background: #1c293b;
            padding: 40px;
            border-radius: 16px;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 15px 40px rgba(0,0,0,.3);
        }

        .brand {
            color: #ff7628;
            font-size: 32px;
            font-weight: 800;
        }

        .form-control {
            background: #101827;
            border: 1px solid #40516a;
            color: white;
            padding: 12px;
        }

        .form-control:focus {
            background: #101827;
            color: white;
            border-color: #ff7628;
            box-shadow: none;
        }

        .form-label {
            color: #d4dce8;
        }

        .btn-raceday {
            background: #ff7628;
            color: white;
            font-weight: bold;
            padding: 12px;
            border: none;
        }

        .btn-raceday:hover {
            background: #e65e12;
            color: white;
        }

        a {
            color: #ff8b49;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-4">
            <div class="brand">RACEDAY.</div>
            <p class="text-secondary">Your race. Your journey.</p>
            <h4>Welcome Back</h4>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control"
                       placeholder="Enter your email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control"
                       placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-raceday w-100">
                LOGIN
            </button>
        </form>

        <div class="text-center mt-4">
            <span class="text-secondary">Don't have an account?</span>
            <a asp-controller="Account" asp-action="Register">Register here</a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
