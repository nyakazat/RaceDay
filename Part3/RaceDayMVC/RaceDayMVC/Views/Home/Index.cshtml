@{
    ViewData["Title"] = "Home";
}

<style>
    .hero-section {
        background: linear-gradient(120deg, #101d35, #174b83);
        color: white;
        border-radius: 18px;
        padding: 75px 35px;
        margin-bottom: 40px;
    }

        .hero-section h1 {
            font-size: clamp(2.5rem, 5vw, 4.2rem);
            font-weight: 800;
            letter-spacing: -2px;
        }

        .hero-section p {
            font-size: 1.15rem;
            color: #d6e5f8;
            max-width: 650px;
        }

    .section-title {
        font-weight: 800;
        color: #152744;
    }

    .feature-card {
        border: none;
        border-radius: 14px;
        padding: 25px;
        height: 100%;
        transition: transform .2s ease;
    }

        .feature-card:hover {
            transform: translateY(-5px);
        }

    .feature-icon {
        font-size: 35px;
        margin-bottom: 15px;
    }

    .event-placeholder {
        background: #eaf1fb;
        border-radius: 14px;
        padding: 30px;
        text-align: center;
        height: 100%;
    }

    .primary-button {
        background: #2878e5;
        border: none;
        color: white;
        padding: 12px 25px;
        border-radius: 7px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
    }

        .primary-button:hover {
            background: #145fc4;
            color: white;
        }

    .secondary-button {
        border: 1px solid white;
        color: white;
        padding: 11px 24px;
        border-radius: 7px;
        text-decoration: none;
        display: inline-block;
        font-weight: 600;
    }

        .secondary-button:hover {
            background: white;
            color: #152744;
        }

    .bottom-banner {
        background: #152744;
        color: white;
        padding: 40px;
        border-radius: 15px;
        margin-top: 40px;
    }
</style>

<div class="hero-section">

    <div class="row align-items-center">

        <div class="col-lg-8">

            <span class="badge bg-primary mb-3">
                YOUR SPORTING JOURNEY STARTS HERE
            </span>

            <h1>
                Your Race.<br />
                Your Day.
            </h1>

            <p class="mt-3 mb-4">
                Discover sporting events, challenge yourself,
                register for competitions and track your performance
                with RaceDay.
            </p>

            <a asp-controller="Home"
               asp-action="Events"
               class="primary-button me-2">
                Explore Events
            </a>

            <a asp-controller="Account"
               asp-action="Register"
               class="secondary-button">
                Create Account
            </a>

        </div>

        <div class="col-lg-4 text-center mt-4 mt-lg-0">

            <div style="font-size: 115px;">
                🏆
            </div>

            <h4 class="fw-bold">Compete. Achieve. Repeat.</h4>

        </div>

    </div>

</div>

<div class="text-center mb-4">

    <h2 class="section-title">Everything You Need</h2>

    <p class="text-muted">
        One platform for sporting events and competition management.
    </p>

</div>

<div class="row g-4">

    <div class="col-md-4">

        <div class="card feature-card shadow-sm">

            <div class="feature-icon">🏃</div>

            <h4 class="fw-bold">Discover Events</h4>

            <p class="text-muted">
                Find sporting competitions and explore
                opportunities to participate.
            </p>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card feature-card shadow-sm">

            <div class="feature-icon">📝</div>

            <h4 class="fw-bold">Easy Registration</h4>

            <p class="text-muted">
                Create an account and enrol in sporting
                events that interest you.
            </p>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card feature-card shadow-sm">

            <div class="feature-icon">🏅</div>

            <h4 class="fw-bold">Track Results</h4>

            <p class="text-muted">
                Follow competition results and keep track
                of your sporting achievements.
            </p>

        </div>

    </div>

</div>

<div class="mt-5">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h2 class="section-title mb-1">Discover Sporting Events</h2>
            <p class="text-muted mb-0">
                Your next challenge awaits.
            </p>
        </div>

    </div>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="event-placeholder">

                <div style="font-size: 45px;">🏃</div>

                <h5 class="fw-bold mt-3">Running Events</h5>

                <p class="text-muted">
                    Discover running competitions and challenges.
                </p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="event-placeholder">

                <div style="font-size: 45px;">🚴</div>

                <h5 class="fw-bold mt-3">Cycling Events</h5>

                <p class="text-muted">
                    Find cycling competitions and test your limits.
                </p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="event-placeholder">

                <div style="font-size: 45px;">🏊</div>

                <h5 class="fw-bold mt-3">Other Competitions</h5>

                <p class="text-muted">
                    Explore more sporting opportunities.
                </p>

            </div>

        </div>

    </div>

</div>

<div class="bottom-banner text-center">

    <h2 class="fw-bold">Ready to get started?</h2>

    <p class="mb-4">
        Join RaceDay and take your place in the next competition.
    </p>

    <a asp-controller="Account"
       asp-action="Register"
       class="primary-button">
        Register Now
    </a>

</div>
