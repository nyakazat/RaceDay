@model List<RaceDayMVC.ViewModels.ResultViewModel>

@{
    ViewData["Title"] = "Manage Results";

    var events = ViewBag.Events
        as List<RaceDayMVC.ViewModels.EventViewModel>
        ?? new List<RaceDayMVC.ViewModels.EventViewModel>();
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Manage Results</h1>
            <p class="text-muted">
                View and manage results for your sporting events.
            </p>
        </div>

        <a asp-controller="Organiser"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h6 class="text-muted">Total Results</h6>
                <h2 class="fw-bold">@Model.Count</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h6 class="text-muted">Events</h6>
                <h2 class="fw-bold">@events.Count</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h6 class="text-muted">Participants with Results</h6>
                <h2 class="fw-bold">
                    @Model.Select(r => r.UserID).Distinct().Count()
                </h2>
            </div>
        </div>

    </div>

    @if (Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>Result ID</th>
                                <th>Event</th>
                                <th>Participant ID</th>
                                <th>Finish Time</th>
                                <th>Position</th>
                                <th>Points</th>
                                <th>Date Recorded</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var result in Model)
                            {
                                var raceEvent = events.FirstOrDefault(
                                e => e.EventID == result.EventID);

                                <tr>
                                    <td>@result.ResultID</td>

                                    <td>
                                        @(raceEvent?.EventName ?? "Unknown Event")
                                    </td>

                                    <td>@result.UserID</td>

                                    <td>@result.FinishTime</td>

                                    <td>
                                        <span class="badge bg-primary">
                                            @result.FinishPosition
                                        </span>
                                    </td>

                                    <td>@result.Points</td>

                                    <td>
                                        @result.DateRecorded.ToString("dd MMM yyyy")
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No results have been recorded for your events yet.
        </div>
    }

</div>
